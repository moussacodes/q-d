{
  "name": "qd",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "ios": "expo start --ios --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p supabase/tests",
    "lint": "expo lint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "node -e \"try { require('child_process').execFileSync('git', ['config', 'core.hooksPath', '.githooks'], { stdio: 'ignore' }) } catch {}\""
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "expo": "~58.1.0",
    "expo-asset": "~58.0.21",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.19",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "prettier": "^3.10.1",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "setupFilesAfterEnv": [
          "<rootDir>/src/test/jest-setup.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/.maestro/",
          "<rootDir>/supabase/"
        ]
      },
      {
        "displayName": "db",
        "testEnvironment": "node",
        "setupFilesAfterEnv": [
          "<rootDir>/supabase/tests/harness/jest-setup.ts"
        ],
        "testMatch": [
          "<rootDir>/supabase/tests/**/*.test.ts"
        ],
        "transform": {
          "\\.ts$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ],
          "[/\\\\]node_modules[/\\\\]@electric-sql[/\\\\].+\\.c?js$": "<rootDir>/supabase/tests/harness/pglite-transform.js"
        },
        "transformIgnorePatterns": [
          "[/\\\\]node_modules[/\\\\](?!@electric-sql[/\\\\])"
        ]
      }
    ]
  }
}
