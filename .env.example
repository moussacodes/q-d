# q’d environment variables: names only. Never put real values in this file.
#
# Every EXPO_PUBLIC_* value is built into the app, so anyone with the app can
# read it. Only public values may use that prefix.

# Demo account reset (operator only, never the app) ----------------------------
# Used by supabase/scripts/reset-demo-accounts.js (docs/DEMO_RUNBOOK.md).
# Put the values in `.env.demo.local` (ignored by git), never in `.env`, and
# never with an EXPO_PUBLIC_ prefix: the service-role key bypasses row level
# security. Run with:
#   node --env-file=.env.demo.local supabase/scripts/reset-demo-accounts.js
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The demo accounts, separated by commas or spaces. Ids, emails or both.
QD_DEMO_USER_IDS=
QD_DEMO_EMAILS=
