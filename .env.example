# q’d environment variables: names only. Never put real values in this file.
#
# Copy it to `.env` (ignored by git) and fill in what you need. Nothing is
# required: with no `.env`, the app runs on mock data and labels it as mock.
# src/services/env.ts validates every value at startup.
#
# Every EXPO_PUBLIC_* value is built into the app, so anyone with the app can
# read it. Only public values go here. Server secrets (a Supabase secret or
# service-role key, an Apple signing key, a Spotify client secret) belong in
# Supabase Edge Function secrets, never here. The app rejects a Supabase
# secret or service-role key.

# Data source: mock (default) or live. live also needs the two Supabase
# values below, and falls back to mock until the live data cards land.
EXPO_PUBLIC_DATA_MODE=

# Supabase project URL and its publishable (or legacy anon) key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Feature flags: true or false. All default to false.
EXPO_PUBLIC_FLAG_REAL_APPLE_MUSIC=
EXPO_PUBLIC_FLAG_REAL_SPOTIFY=
# sync (beta) is private. This build ignores the flag and keeps it off.
EXPO_PUBLIC_FLAG_SYNC=
EXPO_PUBLIC_FLAG_PLAYLIST_IMPORT=
EXPO_PUBLIC_FLAG_MODERATION=
# Analytics also need each person's opt-in.
EXPO_PUBLIC_FLAG_ANALYTICS=
